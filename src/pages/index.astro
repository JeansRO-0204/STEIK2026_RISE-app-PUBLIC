---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

const VALUES = ['Reinforce', 'Ignite', 'Strengthen', 'Elevate'];

const KEYS = [
  { letter: 'R', outer: 'bg-key-r', inner: 'bg-white/20' },
  { letter: 'I', outer: 'bg-key-i', inner: 'bg-white/20' },
  { letter: 'S', outer: 'bg-key-s', inner: 'bg-white/20' },
  { letter: 'E', outer: 'bg-key-e', inner: 'bg-white/20' },
];

const LOREM =
  'lorem ipsum dolor sit amet consectetur adipiscing elit est occaecat tempor cumque voluptas aute omnis nobis quis ullamco magna distinctio aut cum officia mollitia iusto mollitia dolorem est sunt sed animi id consequat laboris amet do dolores eiusmod cupiditate eu aute qui';
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto flex min-h-[60vh] max-w-[1440px] flex-col items-center justify-center px-4 py-24 sm:min-h-[900px]">
      <!-- TODO: computer icon (top-right of title) not exported yet -->
      <img
        src="/icons/keyboard-blue.png"
        alt=""
        width="116"
        height="116"
        class="absolute top-[55%] left-[8%] w-12 [image-rendering:pixelated] sm:left-[20%] sm:w-24"
      />
      <h1 class="text-center leading-[0.85]">
        <span class="block text-[clamp(3rem,10vw,9.5rem)] font-normal">Welcome to</span>{' '}
        <span class="text-script block pl-[10%] text-[clamp(3rem,10vw,9.5rem)]">Rise Camp</span>
      </h1>
      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-base italic sm:text-2xl">
        {VALUES.map((value, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-xs not-italic">◆</span>}
            <span>{value}</span>
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1440px] items-center gap-8 px-4 py-24 sm:px-14 md:grid-cols-2 md:gap-10 md:py-40">
    <!-- TODO: replace with the class photo once exported -->
    <Placeholder label="Foto angkatan STEI-K '26" class="aspect-[704/430] rounded-[40px]" />
    <div class="space-y-4">
      <h2 class="text-5xl leading-none font-semibold sm:text-7xl">
        Hello! <span class="text-script font-normal">We are</span>
        <br />
        <span class="text-script font-normal">stei-k</span> <span class="font-normal">‘26!</span>
      </h2>
      <p class="text-lg font-light sm:text-2xl">{LOREM}</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-4 pb-16 text-center sm:px-16">
    <h2 class="text-4xl sm:text-7xl">
      The <span class="text-script px-2">philosophy</span> behind
    </h2>
    <ul class="mx-auto mt-8 grid max-w-5xl grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-10">
      {KEYS.map(({ letter, outer, inner }) => (
        <li
          class:list={[
            'relative aspect-[242/142] rounded-3xl p-[16%_16%_25%] shadow-[inset_0_-10px_0_rgba(0,0,0,0.18),0_6px_10px_rgba(0,0,0,0.15)]',
            outer,
          ]}
        >
          <span
            class:list={[
              'text-script flex h-full items-center justify-center rounded-2xl text-5xl text-white ring-1 ring-black/10 sm:text-6xl',
              inner,
            ]}
          >
            {letter}
          </span>
        </li>
      ))}
    </ul>
    <p class="mx-auto mt-10 max-w-6xl text-lg font-light sm:text-2xl">{LOREM}</p>
  </section>
</BaseLayout>
