---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkGroup from '../components/LinkGroup.astro';
import { LINK_GROUPS } from '../data/links';
---

<BaseLayout title="Resources" description="Shared Drive folders and documents.">
  <h1 class="mb-8 text-3xl font-bold tracking-tight">Resources</h1>
  <div class="space-y-10">
    {LINK_GROUPS.map((group) => <LinkGroup group={group} />)}
  </div>
</BaseLayout>
