---
import { Image } from 'astro:assets';
import { NAV } from '../consts';
import logo from '../assets/logo-steik.png';

interface Props {
  variant?: 'light' | 'brand';
}

const { variant = 'light' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={[variant === 'brand' ? 'bg-brand text-white' : 'bg-white text-black']}>
  <nav class="mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-4 py-4 sm:px-9 sm:py-6">
    <ul class="flex gap-4 overflow-x-auto whitespace-nowrap text-sm sm:gap-8 sm:text-2xl">
      {NAV.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class="decoration-2 underline-offset-8 hover:underline aria-[current=page]:underline"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/" class="shrink-0" aria-label="STEI-K — beranda">
      <Image src={logo} alt="STEIK" height={48} class="h-8 w-auto sm:h-12" />
    </a>
  </nav>
</header>
