---
// Deterministic "pixel city" divider between the blue and white sections.
const COLS = 72;
const heights = Array.from({ length: COLS }, (_, i) => 1 + ((i * 37 + (i % 5) * 11) % 5));
---

<svg viewBox={`0 0 ${COLS * 20} 100`} preserveAspectRatio="none" class="block h-12 w-full sm:h-24" aria-hidden="true">
  <rect width="100%" height="100" class="fill-brand" />
  {heights.map((h, i) => (
    <rect x={i * 20} y={100 - h * 14} width="20" height={h * 14} class="fill-white" />
  ))}
</svg>
